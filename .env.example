# Copy to .env.local for local runs, or set these on your hosting platform.
# Nothing here is a real credential: the database and cache are disposable demo
# services, and the two secrets are random values you generate yourself.

# Read-only demo: snapshot data, no background workers, no writes (see README).
DEMO_MODE=true

# PostgreSQL holding only the demo snapshot. Matches docker-compose.yml locally.
DATABASE_URL=postgresql://agentranking:agentranking@127.0.0.1:5432/agentranking_demo?sslmode=disable

# Redis-compatible cache (Valkey locally; an Upstash rediss:// URL when hosted).
VALKEY_URL=redis://127.0.0.1:6379/0

# Generate each with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Encrypts the unfunded wallets created for the demo account's sample agents.
CUSTODIAL_WALLET_ENCRYPTION_KEY=

# Public origin of the deployment. Must be set before building, because the
# NEXT_PUBLIC_* values are compiled into the browser bundle.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STAKE_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_SITE_URL=http://localhost:3000/analytics
