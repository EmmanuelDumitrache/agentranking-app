+// Browser/ESM-safe equivalent of Anchor's NodeWallet. Anchor 0.30.1 does not
+// export Wallet from its ESM/browser entrypoint, so importing that name makes
+// strict bundlers (including Turbopack) fail before this module can execute.
+// Keep the local binding name as Wallet to minimize changes to the published
+// helper artifact while backporting upstream PR #84's KeypairWallet behavior.
+const Wallet = class KeypairWallet {
+    payer;
+    constructor(payer) {
+        this.payer = payer;
+    }
+    get publicKey() {
+        return this.payer.publicKey;
+    }
+    async signTransaction(tx) {
+        if ('version' in tx) {
+            tx.sign([this.payer]);
+        }
+        else {
+            tx.partialSign(this.payer);
+        }
+        return tx;
+    }
+    async signAllTransactions(txs) {
+        for (const tx of txs) {
+            if ('version' in tx) {
+                tx.sign([this.payer]);
+            }
+            else {
+                tx.partialSign(this.payer);
+            }
+        }
+        return txs;
+    }
+};
