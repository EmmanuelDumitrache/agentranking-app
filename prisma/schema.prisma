/**
 * Durable, bounded operational projection for queue health. This is intentionally
 * separate from pg-boss retention so health reads never materialize job history.
 */
model WorkerQueueHealth {
  queueName             String   @id @map("queue_name")
  lastCompletedAt       DateTime? @map("last_completed_at") @db.Timestamptz(3)
  lastCompletedStatus   String?   @map("last_completed_status")
  lastCompletedReason   String?   @map("last_completed_reason")
  lastFailedAt          DateTime? @map("last_failed_at") @db.Timestamptz(3)
  lastFailureMessage    String?   @map("last_failure_message") @db.Text
  lastFailurePrunedAt   DateTime? @map("last_failure_pruned_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  failures              WorkerQueueFailure[]

  @@map("worker_queue_health")
}

/**
 * Small retained failure ledger used for exact rolling-window counts and the
 * latest sanitised diagnostics. Rows older than the retention window are pruned
 * by the worker while recording failures.
 */
model WorkerQueueFailure {
  id        BigInt            @id @default(autoincrement())
  queueName String            @map("queue_name")
  queue     WorkerQueueHealth @relation(fields: [queueName], references: [queueName], onDelete: Cascade)
  jobId     String?           @map("job_id")
  message   String?           @db.Text
  failedAt  DateTime          @default(now()) @map("failed_at") @db.Timestamptz(3)

  @@index([queueName, failedAt(sort: Desc), id(sort: Desc)], map: "worker_queue_failures_queue_failed_idx")
  @@map("worker_queue_failures")
}

/**
 * Canonical live DAO votes ranking table. Kept separate from Agent so admin edits and
 * staking-derived aggregation can be audited without mutating trust fields.
 */
model DaoLeaderboardLive {
  id             Int      @id @default(autoincrement())
  agentId        Int      @unique
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  daoVotes       Int      @default(0)
  stakingVotes   Int      @default(0)
  adminVotes     Int      @default(0)
  paidBoostVotes Int      @default(0)
  rank           Int      @default(0)
  notes          String   @default("")
  source         String   @default("aggregated") // aggregated|admin
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([rank])
  @@index([daoVotes(sort: Desc)])
}

/**
 * Historical daily snapshots for day/week/all-time DAO views.
 */
model DaoLeaderboardSnapshot {
  id           Int      @id @default(autoincrement())
  capturedAt   DateTime @default(now())
  periodKey    String   @default("day") // day|week
  agentId      Int
  agent        Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  daoVotes     Int      @default(0)
  stakingVotes Int      @default(0)
  adminVotes   Int      @default(0)
  rank         Int      @default(0)

  @@index([capturedAt])
  @@index([periodKey, capturedAt])
  @@index([agentId, capturedAt])
}

model ConversionEvent {
  id             Int      @id @default(autoincrement())
  idempotencyKey String?  @unique @map("idempotency_key")
  eventType      String // page_view_advertise | page_view_boost | page_view_verify | order_created
  path           String?  @default("")
  productType    String? // power_boost | ad | kya_verify (for order_created)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
}

model ContactInquiry {
  id        Int                   @id @default(autoincrement())
  name      String
  email     String
  subject   String                @default("")
  message   String                @db.Text
  status    String                @default("open") // open | resolved
  userId    Int?
  userRef   UserProfile?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime              @default(now())
  replies   ContactInquiryReply[]

  @@index([userId])
  @@index([status])
}

model ContactInquiryReply {
  id          Int            @id @default(autoincrement())
  inquiryId   Int
  inquiry     ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  body        String         @db.Text
  /// admin | user
  authorRole  String         @default("admin")
  readByAdmin Boolean        @default(false)
  readByUser  Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([inquiryId])
}

model AgentAnalyticsEvent {
  id        Int           @id @default(autoincrement())
  agentId   Int
  agent     Agent         @relation(fields: [agentId], references: [id])
  serviceId Int?
  service   AgentService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  eventType String // "view" | "click_endpoint" | "click_service" | "click_x402"
  createdAt DateTime      @default(now())
  // eventType_createdAt index dropped: unused per pg_stat_user_indexes (0 scans)

  @@index([agentId, createdAt])
  @@index([agentId, serviceId, createdAt])
}

model AgentRankSnapshot {
  id            Int      @id @default(autoincrement())
  agentId       Int
  agent         Agent    @relation(fields: [agentId], references: [id])
  rank          Int
  archetypeRank Int? // Rank within archetype (null if no archetype)
  score         Float
  agentRankScore Int      @default(0) // AR composite score at capture time
  capturedAt    DateTime @default(now())

  @@index([capturedAt, id], map: "AgentRankSnapshot_retention_idx")
}

model AgentPerfSnapshot {
  id         Int      @id @default(autoincrement())
  agentId    Int
  agent      Agent    @relation(fields: [agentId], references: [id])
  capturedAt DateTime @default(now())

  txCount           Int   @default(0)
  profitableTxCount Int   @default(0)
  grossProfitUsd    Float @default(0)
  totalFeesUsd      Float @default(0)
  totalGasUsd       Float @default(0)
  netPnlUsd         Float @default(0)
  volumeUsd         Float @default(0)

  winRate         Float @default(0)
  burnToEarnRatio Float @default(0)
  avgPnlPercent   Float @default(0)

  /**
   * Moralis / Helius / viem raw responses for debugging and Pro analytics.
   */
  rawStatsJson Json?

  // agentId_capturedAt and capturedAt indexes dropped: table has 0 rows, 0 scans — re-add when performance engine is implemented
}

model WalletLinkChallenge {
  id        String    @id @default(cuid())
  agentId   Int
  agent     Agent     @relation(fields: [agentId], references: [id])
  wallet    String // The execution wallet being linked
  nonce     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // agentId and nonce indexes dropped: 0 scans per pg_stat_user_indexes (nonce has @unique which covers lookups)
}

enum CommerceEventType {
  swap
  m2m_payment
  yield_deposit
}

/// Parsed commerce rows for Agent-Financials MCP (Helius/Alchemy). Retention ~90d via scheduled delete.
model CommerceRawEvent {
  id                   String            @id @default(cuid())
  walletAddress        String
  chainId              Int
  linkedAgentDbId      Int?
  linkedAgent          Agent?            @relation(fields: [linkedAgentDbId], references: [id], onDelete: SetNull)
  eventType            CommerceEventType
  volumeUsd            Decimal           @db.Decimal(24, 8)
  feeUsd               Decimal           @db.Decimal(24, 8)
  txHash               String
  eventIndex           Int               @default(0)
  occurredAt           DateTime
  ingestedAt           DateTime          @default(now())
  classificationSource String?

  @@unique([chainId, txHash, eventIndex])
  @@index([linkedAgentDbId]) // FK covering index (prevents seq-scan on Agent cascade ops)
  @@map("raw_events")
}

/// Per-wallet rollup for MCP cache (not a DB materialized view; upserted by indexer/MCP refresh).
model FinancialAgentSummary {
  walletAddress  String
  chainId        Int
  totalVolumeUsd Decimal  @db.Decimal(24, 8)
  netPnlUsd      Decimal  @db.Decimal(24, 8)
  winRate        Float
  tradeCount     Int
  lastComputedAt DateTime
  displayName    String?
  isRegistered   Boolean  @default(false)

  @@id([walletAddress, chainId])
  @@map("agent_summaries")
}

/// Public abuse / moderation reports for an agent listing.
model AgentReport {
  id             String   @id @default(cuid())
  agentDbId      Int
  agent          Agent    @relation(fields: [agentDbId], references: [id], onDelete: Cascade)
  chainId        Int
  onChainAgentId Int
  pageUrl        String   @default("")
  category       String   @default("other") // spam|impersonation|malware|other
  details        String   @db.Text
  reporterIpHash String   @default("")
  reporterWallet String   @default("")
  status         String   @default("open") // open|reviewed|dismissed
  adminNotes     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([agentDbId])
  @@index([createdAt])
}

/// Admin rules to hide or reject agents (name/URI/owner/on-chain key).
model AgentBlocklistRule {
  id        String   @id @default(cuid())
  matchType String // name_contains|name_exact|uri_contains|uri_exact|owner_wallet|agent_key
  value     String
  active    Boolean  @default(true)
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// --- Partner jobs ---

/// Public job text search uses a migration-managed partial pg_trgm/btree_gin GIN index.
model PartnerJob {
  id              String    @id @default(cuid())
  source          String
  externalId      String    @map("external_id")
  title           String    @default("")
  description     String    @default("")
  category        String    @default("")
  jobType         String    @default("") @map("job_type")
  rewardAmount    Decimal?  @map("reward_amount") @db.Decimal(18, 8)
  rewardCurrency  String    @default("") @map("reward_currency")
  chain           String    @default("")
  status          String    @default("open")
  applyUrl        String    @default("") @map("apply_url")
  sourceJobUrl    String    @default("") @map("source_job_url")
  sourceStatusUrl String?   @map("source_status_url")
  sourceSecret    String?   @map("source_secret")
  requirements    Json?
  tags            String[]  @default([])
  /** Semantic category facets (social/human_feedback/research/data/growth/contests/manual/on_chain) for SQL filtering. */
  facets          String[]  @default([])
  raw             Json?
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at")
  expiresAt       DateTime? @map("expires_at")
  ingestionMode   String    @default("api") @map("ingestion_mode")
  featured        Boolean   @default(false)
  curatedBy       String?   @map("curated_by")
  isSample        Boolean   @default(false) @map("is_sample")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  interactionEvents JobInteractionEvent[]

  @@unique([source, externalId])
  @@index([source, status, ingestionMode, isSample, lastSeenAt], map: "partner_jobs_stale_scan_idx")
  @@index([status, createdAt])
  @@index([isSample, status], map: "partner_jobs_is_sample_status_idx")
  @@index([facets])
  @@index([tags])
  @@map("partner_jobs")
}

model JobPartnerSource {
  id                   String    @id @default(cuid())
  source               String    @unique
  displayName          String    @map("display_name")
  websiteUrl           String    @default("") @map("website_url")
  docsUrl              String?   @map("docs_url")
  enabled              Boolean   @default(true)
  lastSyncAt           DateTime? @map("last_sync_at")
  lastSyncStatus       String?   @map("last_sync_status")
  lastSyncError        String?   @map("last_sync_error")
  lastIngestionMode    String?   @map("last_ingestion_mode")
  authModeUsed         String?   @map("auth_mode_used")
  lastHttpStatus       Int?      @map("last_http_status")
  endpointUsed         String?   @map("endpoint_used")
  lastSuccessfulSyncAt DateTime? @map("last_successful_sync_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("job_partner_sources")
}

model JobInteractionEvent {
  id        Int         @id @default(autoincrement())
  eventType String      @map("event_type")
  jobId     String?     @map("job_id")
  job       PartnerJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  agentId   Int?        @map("agent_id")
  agent     Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  source    String?
  metadata  Json?
  ipHash    String?     @map("ip_hash")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([jobId, createdAt])
  @@index([agentId, createdAt])
  @@map("job_interaction_events")
}

// --- Bounty Board ---

model Bounty {
  id                   String          @id @default(cuid())
  posterWallet         String
  posterEmail          String          @default("")
  title                String          @default("")
  description          String
  usdcAmount           Float
  /// TODO: Helio escrow tx hash — set after escrow deposit confirmed
  escrowTx             String          @default("")
  /// open|claimed|completed|disputed|expired
  status               String          @default("open")
  claimedByAgentId     Int?
