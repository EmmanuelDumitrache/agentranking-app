generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}


datasource db {
  provider = "postgresql"
}

model Chain {
  id                 Int     @id @default(autoincrement())
  chainId            Int     @unique
  name               String
  shortName          String
  icon               String  @default("")
  color              String  @default("#888")
  identityRegistry   String  @default("")
  reputationRegistry String  @default("")
  validationRegistry String  @default("")
  agentCount         Int     @default(0)
  feedbackCount      Int     @default(0)
  onchainFeedbackCount Int   @default(0) @map("onchain_feedback_count")
  siteFeedbackCount    Int   @default(0) @map("site_feedback_count")
  sourceConfigDigest   String? @map("source_config_digest")
  lastSyncedBlock       Int? // Compatibility cursor for public application reads.
  lastSyncedBlockHash   String? @map("last_synced_block_hash")
  lastFinalizedBlock    BigInt? @map("last_finalized_block")
  lastFinalizedBlockHash String? @map("last_finalized_block_hash")
  finalityPolicy        String? @map("finality_policy")
  /** Worker indexing control; distinct from public chain visibility. */
  indexingEnabled       Boolean @default(true) @map("indexing_enabled")
  isActive              Boolean @default(true)
  agents             Agent[]
}

/// PostgreSQL trigram/unaccent GIN and fuzzy-name GiST indexes are migration-managed because Prisma cannot express the required mixed operator classes/expression indexes.
model Agent {
  id                       Int     @id @default(autoincrement())
  agentId                  Int
  chainId                  Int
  chain                    Chain   @relation(fields: [chainId], references: [chainId])
  name                     String
  description              String  @default("")
  image                    String  @default("")
  agentURI                 String  @default("")
  owner                    String  @default("")
  /** Lossless source identifier. EVM uint256 ids that do not fit the compatibility Int remain observation-only. */
  protocolAgentId          String? @map("protocol_agent_id")
  registeredOwner          String  @default("") @map("registered_owner")
  declaredActive           Boolean? @map("declared_active")
  declaredX402Support      Boolean? @map("declared_x402_support")
  declaredMppSupport       Boolean? @map("declared_mpp_support")
  sourceEvidenceType       String? @map("source_evidence_type")
  sourceFinality           String? @map("source_finality")
  sourceRegistryAddress    String? @map("source_registry_address")
  sourceBlockNumber        BigInt? @map("source_block_number")
  sourceBlockHash          String? @map("source_block_hash")
  sourceTransactionHash    String? @map("source_transaction_hash")
  sourceTransactionIndex   Int? @map("source_transaction_index")
  sourceLogIndex           Int? @map("source_log_index")
  registrationRawDigest    String? @map("registration_raw_digest")
  registrationSemanticFingerprint String? @map("registration_semantic_fingerprint")
  registrationNormalizedUri String? @map("registration_normalized_uri")
  registrationContentAddress String? @map("registration_content_address")
  chainIdentityFingerprint String? @map("chain_identity_fingerprint")
  chainRelationFingerprint String? @map("chain_relation_fingerprint")
  chainMetricsFingerprint String? @map("chain_metrics_fingerprint")
  /** Registry/indexer-owned lifecycle state. Application moderation remains separate. */
  sourceActive             Boolean? @map("source_active")
  sourceLifecycleStatus    String? @map("source_lifecycle_status")
  moderationStatus         String @default("inherit") @map("moderation_status")
  administrativeActiveOverride Boolean? @map("administrative_active_override")
  publiclyActive           Boolean @default(true) @map("publicly_active")
  identityUpdatedAt        DateTime? @map("identity_updated_at") @db.Timestamptz(3)
  metadataUpdatedAt        DateTime? @map("metadata_updated_at") @db.Timestamptz(3)
  activityObservedAt       DateTime? @map("activity_observed_at") @db.Timestamptz(3)
  lastIndexedAt            DateTime? @map("last_indexed_at") @db.Timestamptz(3)
  registrationStatus       String? @map("registration_status")
  registrationLastSuccessAt DateTime? @map("registration_last_success_at") @db.Timestamptz(3)
  registrationLastAttemptAt DateTime? @map("registration_last_attempt_at") @db.Timestamptz(3)
  registrationErrorClass   String? @map("registration_error_class")
  registrationErrorMessage String? @map("registration_error_message") @db.Text
  registrationNextRetryAt  DateTime? @map("registration_next_retry_at") @db.Timestamptz(3)
  feedbackSourceDigest     String? @map("feedback_source_digest")
  evmFeedbackSourceDigest  String? @map("evm_feedback_source_digest")
  solana8004FeedbackSourceDigest String? @map("solana_8004_feedback_source_digest")
  feedbackObservedBlock    BigInt? @map("feedback_observed_block")
  sourceQualityScore       Float? @map("source_quality_score")
  sourceFeedbackCount      Int? @map("source_feedback_count")
  walletHydrationStatus    String @default("pending") @map("wallet_hydration_status")
  walletCapabilityStatus   String? @map("wallet_capability_status")
  walletObservedBlock      BigInt? @map("wallet_observed_block")
  scoreStateVersion        BigInt @default(1) @map("score_state_version")
  scoreMaterializedVersion BigInt @default(0) @map("score_materialized_version")
  scoreRecalculatedAt      DateTime? @map("score_recalculated_at") @db.Timestamptz(3)
  materializedRelationFingerprint String? @map("materialized_relation_fingerprint")
  relationMaterializationGeneration Int @default(0) @map("relation_materialization_generation")
  isActive                 Boolean @default(true)
  isVerified               Boolean @default(false)
  score                    Float   @default(0)
  hotScore                 Float   @default(0)
  rank                     Int     @default(0)
  x402Support              Boolean @default(false)
  mppSupport               Boolean @default(false)
  /**
   * Product flag: smart batch execution (e.g. batched tool/call flows). Distinct from on-chain registration.
   */
  isSmartBatchEnabled      Boolean @default(false)
  stars                    Int     @default(0)
  totalFeedback            Int     @default(0)
  totalMessages            Int     @default(0)
  totalChats               Int     @default(0)
  totalWatches             Int     @default(0)
  scoreQuality             Float   @default(0)
  scorePopularity          Float   @default(0)
  scoreActivity            Float   @default(0)
  scoreWallet              Float   @default(0)
  scoreFreshness           Float   @default(0)
  scoreVerifiedRevenue     Float   @default(0) @map("score_verified_revenue")
  scoreMetadata            Float   @default(0)
  scoreServices            Float   @default(0)
  scoreSocial              Float   @default(0) @map("score_social")
  scoreCompliance          Float   @default(0) @map("score_compliance")
  supportedTrust           String  @default("reputation")
  isCustomListed           Boolean @default(false)
  isPremiumVerified        Boolean @default(false)
  /**
   * Public verification workflow: unverified | submitted | in_review | verified | rejected.
   * Denormalized from AgentVerificationRequest for fast profile reads.
   */
  publicVerificationStatus String  @default("unverified") @map("public_verification_status")
  binanceCompatible        Boolean @default(false)
  hasDuplicateName         Boolean @default(false)
  powerScore               Float   @default(0)
  agentRankScore           Float   @default(0)
  /**
   * Homepage Recommended sort blend (see discovery-recommendation-score.ts); organic rank still uses agentRankScore.
   */
  discoveryScore           Float   @default(0) @map("discovery_score")
  activityScore            Float   @default(0)
  /**
   * Added to the persisted power formula; global power/rank projection is mutation-driven.
   */
  adminPowerAdjust         Int     @default(0)
  activeBoosts             Int     @default(0)
  voteFireCount            Int     @default(0)
  votePooCount             Int     @default(0)
  tokenAddress             String  @default("")
  archetype                String  @default("") // "trading"|"arbitrage"|"sniper"|"yield"|"builder"|"analytics"|"bridge"|"copy_trader"|"social"|"mev"
  archetypeAuto            Boolean @default(false) // true = auto-detected, false = manually set
  agentMode                String  @default("unknown") // "autonomous"|"copilot"|"hybrid"|"unknown"
  protocolTrustScore        Int     @default(0) // Protocol trust score
  executionScore           Int     @default(0) // Execution performance

  // --- Verified execution and revenue signals ---
  verifiedWallet           String    @default("") // Cryptographically linked execution wallet
  verifiedWalletAt         DateTime? // When wallet was linked
  verifiedWalletChainId    Int? // Chain of the execution wallet
  perfWinRate              Float? // % of trades that were profitable (rolling 30d)
  perfAvgPnlPercent        Float? // Average PnL % per operation
  perfBurnToEarnRatio      Float? // (gas+fees) / grossProfit — lower is better
  perfTotalVolumeUsd       Float? // Lifetime volume through execution wallet
  perfMonthlyPnlUsd        Float? // Rolling 30d net PnL in USD
  perfLastComputedAt       DateTime? // When perf fields were last updated
  /**
   * ERC-20 transfer events in the perf window (denormalized from last snapshot job).
   */
  perfTxCount              Int?
  /**
   * Inbound transfer count proxy used for win-rate heuristics (denormalized).
   */
  perfProfitableTxCount    Int?
  isVerifiedRevenue        Boolean   @default(false) // Distinct from isPremiumVerified (identity)
  verifiedRevenueAt        DateTime?
  /**
   * When time-limited verified revenue ends; null = lifetime (e.g. verification bundle).
   */
  verifiedRevenueExpiresAt DateTime?

  // --- Recent on-chain activity cache ---
  /** Last N normalized swap items from Helius/Moralis. NormalizedActivityItem[]. */
  recentActivity    Json?
  /**
   * When recentActivity was last successfully fetched — used as cache TTL key.
   */
  activityUpdatedAt DateTime?
  /**
   * Heuristic win rate from swap-pair analysis (30d window). Separate from perfWinRate (official pipeline).
   */
  activeWinRate30d  Float?
  /**
   * Notional volume in native SOL or ETH (not USD) from swap legs.
   */
  nativeVolume30d   Float?

  // --- SAP (Synapse Agent Protocol) read-only indexer ---
  /** Source registry for listing row: `default` | `sap` | `hatcher` | `metaplex` | … */
  listingRegistrySource String    @default("default") @map("listing_registry_source")
  sapVerified           Boolean   @default(false) @map("sap_verified")
  sapAgentPda           String?   @unique @map("sap_agent_pda")
  sapStatsPda           String?   @map("sap_stats_pda")
  sapCapabilities       Json?     @map("sap_capabilities")
  sapPricingTiers       Json?     @map("sap_pricing_tiers")
  sapProtocols          String[]  @default([]) @map("sap_protocols")
  sapX402Endpoint       String?   @map("sap_x402_endpoint")
  sapRegistrationTx     String?   @map("sap_registration_tx")
  sapLastSyncedAt       DateTime? @map("sap_last_synced_at")
  /**
   * Raw serialized AgentStats PDA (and numeric fields as JSON-safe values).
   */
  sapStats              Json?     @map("sap_stats")
  sapOwnerWallet        String?   @map("sap_owner_wallet")
  /**
   * On-chain agent account `createdAt` (unix) as observed during sync.
   */
  sapRegisteredAt       DateTime? @map("sap_registered_at")

  // --- SAP relational projections (native columns derived from the SAP indexer) ---
  /** Denormalized capability count for cheap leaderboard/count queries. */
  sapCapabilityCount    Int       @default(0) @map("sap_capability_count")
  /** Minimum price-per-call across pricing tiers (USD-ish units as on chain). */
  sapMinPricePerCall    Decimal?  @map("sap_min_price_per_call") @db.Decimal(18, 8)
  /** Number of pricing tiers published by the agent. */
  sapPricingTierCount   Int       @default(0) @map("sap_pricing_tier_count")
  /** Primary (first) pricing tier id used for display/labels. */
  sapPrimaryTierId      String?   @map("sap_primary_tier_id")
  /** Native projections of `sapStats` identity fields for hot read paths. */
  sapIdentityName       String?   @map("sap_identity_name")
  sapIdentityIsActive   Boolean?  @map("sap_identity_is_active")
  sapReputationScore    Float?    @map("sap_reputation_score")
  sapIdentityTotalCallsServed Decimal? @map("sap_identity_total_calls_served") @db.Decimal(20, 0)
  sapIdentityTotalFeedbacks Int?   @map("sap_identity_total_feedbacks")
  sapStatsTotalCallsServed Decimal? @map("sap_stats_total_calls_served") @db.Decimal(20, 0)
  sapStatsActive        Boolean?  @map("sap_stats_active")
  sapStatsUpdatedAt     DateTime? @map("sap_stats_updated_at") @db.Timestamptz(3)
  /** Relational capability rows mirroring the canonical `sapCapabilities` JSON. */
  sapCapabilityRows     AgentSapCapability[]

  // --- 8004 Solana canonical source evidence ---
  solanaAssetAddress         String? @unique @map("solana_asset_address")
  solanaSequenceId           BigInt? @map("solana_sequence_id")
  solanaCanonicalStatus      String? @map("solana_canonical_status")
  solanaCommitment           String? @map("solana_commitment")
  solanaSlot                 BigInt? @map("solana_slot")
  solanaTransactionSignature String? @map("solana_transaction_signature")
  solanaEventOrdinal         Int? @map("solana_event_ordinal")
  solanaOfficialRank         BigInt? @map("solana_official_rank")
  solanaAtomTrustTier        String? @map("solana_atom_trust_tier")
  solanaIndexerUpdatedAt     DateTime? @map("solana_indexer_updated_at") @db.Timestamptz(3)
  solanaBlockTime            DateTime? @map("solana_block_time") @db.Timestamptz(3)

  // --- Metaplex Agent Registry (MPL Core + AgentIdentity) ---
  metaplexSourceType               String    @default("agent-registry") @map("metaplex_source_type")
  metaplexAssetAddress             String?   @unique @map("metaplex_asset_address")
  metaplexAgentIdentityPda         String?   @map("metaplex_agent_identity_pda")
  metaplexAgentRegistrationUri     String?   @map("metaplex_agent_registration_uri")
  metaplexAgentTokenMint           String?   @map("metaplex_agent_token_mint")
  metaplexAssetSignerPda           String?   @map("metaplex_asset_signer_pda")
  metaplexVerified                 Boolean   @default(false) @map("metaplex_verified")
  metaplexTokenBindingStatus       String    @default("unbound") @map("metaplex_token_binding_status")
  metaplexSupportedTrust           String[]  @default([]) @map("metaplex_supported_trust")
  metaplexActive                   Boolean?  @map("metaplex_active")
  metaplexRawData                  Json?     @map("metaplex_raw_data")
  metaplexLastIndexedAt            DateTime? @map("metaplex_last_indexed_at")
  metaplexLaunchAddress            String?   @map("metaplex_launch_address")
  metaplexLaunchType               String?   @map("metaplex_launch_type")
  metaplexLaunchStatus             String?   @map("metaplex_launch_status")
  metaplexBondingProgressPct       Float?    @map("metaplex_bonding_progress_pct")
  metaplexBondingProgressSource    String?   @map("metaplex_bonding_progress_source")
  metaplexBondingProgressUpdatedAt DateTime? @map("metaplex_bonding_progress_updated_at")
  metaplexTradeUrl                 String?   @map("metaplex_trade_url")
  /**
   * Index-time DexScreener snapshot for directory tradeable filter.
   */
  metaplexHasDexPair               Boolean?  @map("metaplex_has_dex_pair")

  /**
   * Short code for /ag-ref/:code; null = owner has not enabled a public referral link.
   */
  publicReferralCode        String? @unique @map("public_referral_code")
  /**
   * Relative path (/...) or https URL; empty = redirect to agent profile.
   */
  publicReferralDestination String  @default("") @map("public_referral_destination")
  /**
   * Optional promo line under the code on the public profile.
   */
  publicReferralInfo        String  @default("") @map("public_referral_info")

  // --- Work-ready agent curation ---
  /** none | pending | approved — manual admin override for the featured jobs section. */
  workReadyStatus    String    @default("none") @map("work_ready_status")
  workReadyReasons   String[]  @default([]) @map("work_ready_reasons")
  featuredWorkReady  Boolean   @default(false) @map("featured_work_ready")
  workReadyUpdatedAt DateTime? @map("work_ready_updated_at")

  createdAt                 DateTime                   @default(now())
  /**
   * Feed ordering: set on create; bump when an agent becomes active again after inactive (EVM worker + app upsert). Solana: set on create only, not on every indexer poll.
   */
  listedAt                  DateTime                   @default(now())
  lastActiveAt              DateTime                   @default(now())
  services                  AgentService[]
  feedbacks                 Feedback[]
  feedbackScoreAggregate    AgentFeedbackScoreAggregate?
  solana8004TrustObservations Solana8004TrustObservation[]
  metadata                  AgentMetadata[]
  agentStars                AgentStar[]
  promotions                Promotion[]
  agentBoosts               AgentBoost[]
  agentVotes                AgentVote[]
  orders                    Order[]                    @relation("AgentOrders")
  analyticsEvents           AgentAnalyticsEvent[]
  rankSnapshots             AgentRankSnapshot[]
  perfSnapshots             AgentPerfSnapshot[]
  walletChallenges          WalletLinkChallenge[]
  commerceRawEvents         CommerceRawEvent[]
  bountiesClaimed           Bounty[]
  trustEvents               TrustEvent[]
  alertEvents               AgentAlertEvent[]
  meshPublished             MeshSubscription[]         @relation("MeshPublisher")
  meshSubscribed            MeshSubscription[]         @relation("MeshSubscriber")
  alertRules                AgentAlertRule[]
  sapOperatorClaim          SapAgentOperatorClaim?
  fairscaleAssessment      FairscaleAgentAssessment?
  agentReports              AgentReport[]
  mcpOffers                 AgentMcpOffer[]
  holderAgentPerks          ArHolderAgentPerk[]
  daoVotesLive              DaoLeaderboardLive?
  daoVoteSnapshots          DaoLeaderboardSnapshot[]
  verificationRequests      AgentVerificationRequest[]
  verificationSignals       AgentVerificationSignal[]
  agentPassports            AgentPassport[]
  agentDelegations          AgentDelegation[]          @relation("DelegatedAgent")
  treasuryTransactions      TreasuryTransaction[]      @relation("AgentTreasuryTransactions")
  agentIssuingCard          AgentIssuingCard?
  agentStablecoinLedger     AgentStablecoinLedger?
  agentLithicCard           AgentLithicCard?
  agentMarqetaCard          AgentMarqetaCard?
  agentKripicardCards       AgentKripicardCard[]
  officialLinks             AgentOfficialLink[]
  paidServices              AgentPaidService[]
  analyticsDaily            AgentAnalyticsDaily[]
  githubConnections         AgentGithubConnection[]
  githubSnapshots           AgentGithubSnapshot[]
  githubPushNotes           AgentGithubPushNote[]
  jobInteractionEvents      JobInteractionEvent[]
  agentLaunches             AgentLaunch[]              @relation("AgentLaunchLinkedAgent")
  agentTrades               AgentTrade[]
  copyTradeConfigs          AgentCopyTradeConfig[]
  schedules                 AgentSchedule[]
  /**
   * Stable multi-chain cluster id for list dedupe (e.g. cluster:56:127417).
   * Assigned by cluster reconciliation; optional until the relevant source is reconciled.
   */
  clusterKey                String?                    @map("cluster_key")
  /**
   * AgentRanking-native verification (on-chain payment via account wallet).
   */
  arVerificationStatus      String                     @default("unverified") @map("ar_verification_status") // unverified | pending | verified | failed
  arVerifiedAt              DateTime?                  @map("ar_verified_at")
  arVerificationTxSignature String?                    @map("ar_verification_tx_signature")
  arVerificationFeeLamports BigInt?                    @map("ar_verification_fee_lamports")
  arVerificationWallet      String?                    @map("ar_verification_wallet") // which wallet paid
  arVerificationRecipient   String?                    @map("ar_verification_recipient") // treasury wallet
  /**
   * Dashboard account that owns this native agent (custodial wallet layer).
   */
  ownerAccountId            String?                    @map("owner_account_id")
  ownerAccount              AppAccount?                @relation("AgentOwnerAccount", fields: [ownerAccountId], references: [id], onDelete: SetNull)
  agentWalletId             String?                    @unique @map("agent_wallet_id")
  agentWallet               CustodialWallet?           @relation("AgentCustodialWallet", fields: [agentWalletId], references: [id], onDelete: SetNull)
  chatSettings              AgentChatSettings?
  chatConversations         AgentChatConversation[]
  mcpBindings               AgentMcpBinding[]
  mcpContinuations          AgentMcpContinuation[]
  mcpAuditLogs              AgentMcpAuditLog[]
  memorySettings            AgentMemorySettings[]
  memoryFacts               AgentMemoryFact[]
  solanaRegistryMemberships SolanaRegistryMembership[]

  // ═══ EVM wallet (Robinhood Chain 4663) — custodial wallet with optional Privy provider ═══
  /// EVM address (checksum/lowercase). Null when not configured.
  evmWalletAddress    String?  @unique @map("evm_wallet_address")
  /// Privy wallet identifier. Null for custodial wallets.
  evmPrivyWalletId    String?  @unique @map("evm_privy_wallet_id")
  /// Wallet provider: 'custodial' | 'privy_embedded'
  evmWalletProvider   String   @default("custodial") @map("evm_wallet_provider")
  /// not_configured | creating | active | failed
  evmWalletStatus     String   @default("not_configured") @map("evm_wallet_status")
  /// When the EVM wallet was created/persisted.
  evmWalletCreatedAt  DateTime? @map("evm_wallet_created_at")
  /// Custodial EVM keypair (encrypted). Preferred over Privy for one-click launch/claim.
  agentEvmWalletId    String?  @unique @map("agent_evm_wallet_id")
  agentEvmWallet      CustodialWallet? @relation("AgentEvmCustodialWallet", fields: [agentEvmWalletId], references: [id], onDelete: SetNull)

  @@unique([agentId, chainId])
  // Composite tenant key used by account-scoped child records. An unowned
  // agent (ownerAccountId = null) cannot satisfy a required tenant FK.
  @@unique([id, ownerAccountId], map: "Agent_id_owner_account_id_key")
  @@index([evmWalletStatus])
  @@index([chainId, agentId(sort: Desc)], map: "Agent_chain_id_agent_id_desc_idx")
  @@index([chainId, protocolAgentId])
  @@index([sourceBlockNumber])
  @@index([solanaCanonicalStatus, solanaSlot])
  @@index([score])
  @@index([hotScore])
  @@index([powerScore])
  @@index([createdAt])
  @@index([listedAt])
  @@index([owner])
  // Broad active/sort composites were replaced by production query-plan indexes
  // after pg_stat_user_indexes review.
  @@index([isActive, activityScore])
  @@index([isActive, agentRankScore(sort: Desc)])
  @@index([isActive, discoveryScore(sort: Desc)], map: "Agent_isActive_discoveryScore_idx")
  @@index([isActive, id]) // sitemap chunk scans: active agents ordered by primary key
  @@index([archetype])
  @@index([isActive, archetype])
  @@index([isActive, agentMode])
  @@index([isActive, protocolTrustScore])
  @@index([clusterKey])
  @@index([isActive, executionScore])
  @@index([isActive, isVerifiedRevenue, score]) // verified revenue leaderboard
  @@index([featuredWorkReady, workReadyStatus])
  @@index([verifiedWallet]) // perf snapshot lookups
  @@index([isActive, sapVerified], map: "Agent_isActive_sapVerified_idx")
  @@index([isActive, metaplexVerified], map: "Agent_isActive_metaplexVerified_idx")
  @@index([registrationStatus, registrationNextRetryAt], map: "Agent_registration_retry_idx")
  @@index([listedAt(sort: Desc), id(sort: Desc)], map: "Agent_scanner_listed_id_idx")
  @@index([scoreStateVersion, scoreMaterializedVersion])
  @@index([chainId, sourceActive, publiclyActive], map: "Agent_source_lifecycle_idx")
  @@index([chainId, sourceRegistryAddress], map: "Agent_source_registry_idx")
  @@index([walletHydrationStatus])
  @@index([sapVerified, isActive, sapReputationScore(sort: Desc), sapRegisteredAt(sort: Desc)], map: "Agent_sap_leaderboard_idx")
}

/// Relational projection of `Agent.sapCapabilities` — indexed one-to-many rows
/// replacing whole-JSON trigram search/aggregation.
model AgentSapCapability {
  id            Int    @id @default(autoincrement())
  agentDbId     Int    @map("agent_db_id")
  agent         Agent  @relation(fields: [agentDbId], references: [id], onDelete: Cascade)
  /** Position within the canonical `sapCapabilities` array. */
  ordinal       Int
  /** Stable capability key (`id` else `protocol@version`) used for grouping. */
  capabilityKey String @map("capability_key")
  /** Raw on-chain capability id (may be empty when only a protocol is present). */
  capabilityId  String @default("") @map("capability_id")
  protocol      String @default("")
  version       String @default("")
  description   String @default("") @db.Text

  @@unique([agentDbId, ordinal], map: "agent_sap_capabilities_agent_ordinal_unique")
  @@index([capabilityKey, agentDbId], map: "agent_sap_capabilities_key_agent_idx")
  @@index([protocol, agentDbId], map: "agent_sap_capabilities_protocol_agent_idx")
  @@index([agentDbId, ordinal], map: "agent_sap_capabilities_agent_ordinal_idx")
  @@map("agent_sap_capabilities")
}

model AgentChatSettings {
  id                String                      @id @default(cuid())
  agentDbId         Int                         @unique @map("agent_db_id")
  agent             Agent                       @relation(fields: [agentDbId], references: [id], onDelete: Cascade)
  currentRevisionId String?                     @map("current_revision_id")
  currentRevision   AgentChatSettingsRevision?  @relation("CurrentAgentChatSettingsRevision", fields: [currentRevisionId, agentDbId], references: [id, agentDbId], onDelete: NoAction)
  revisions         AgentChatSettingsRevision[] @relation("AgentChatSettingsRevisions")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, agentDbId])
  @@unique([currentRevisionId, agentDbId])
  @@map("agent_chat_settings")
}

model AgentChatSettingsRevision {
  id                     String             @id @default(cuid())
  settingsId             String             @map("settings_id")
  agentDbId              Int                @map("agent_db_id")
  settings               AgentChatSettings  @relation("AgentChatSettingsRevisions", fields: [settingsId, agentDbId], references: [id, agentDbId], onDelete: Cascade)
  currentFor             AgentChatSettings? @relation("CurrentAgentChatSettingsRevision")
  revision               Int
