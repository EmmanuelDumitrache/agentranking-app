  network     String @default("devnet")
  mint        String
  txSignature String @unique @map("tx_signature")

  quoteSymbol String @default("SOL") @map("quote_symbol")

  totalAmount   BigInt @map("total_amount")
  arAmount      BigInt @map("ar_amount")
  creatorAmount BigInt @map("creator_amount")

  payloadJson Json? @map("payload_json")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([launchId])
  @@index([mint])
  @@index([network])
  @@map("agent_launch_fee_distributions")
}

/// Durable signed-transaction ledger for retry-safe fee distribution.
/// `prepared` and `submitted` are mutually exclusive per launch via a partial
/// unique index in the migration because Prisma cannot express partial indexes.
model AgentLaunchFeeDistributionAttempt {
  id String @id @default(cuid())

  launchId String      @map("launch_id")
  launch   AgentLaunch @relation(fields: [launchId], references: [id], onDelete: Cascade)

  network String @default("devnet")
  mint    String
  status  String @default("prepared") // prepared | submitted | confirmed | failed
  mode    String @default("standard") // standard | recovery

  txSignature         String @unique @map("tx_signature")
  rawTransactionBase64 String @map("raw_transaction_base64") @db.Text
  recentBlockhash      String @map("recent_blockhash")
  lastValidBlockHeight BigInt @map("last_valid_block_height")

  quoteSymbol String @default("SOL") @map("quote_symbol")

  totalAmount   BigInt @map("total_amount")
  arAmount      BigInt @map("ar_amount")
  creatorAmount BigInt @map("creator_amount")

  payloadJson Json? @map("payload_json")
  submittedAt DateTime? @map("submitted_at")
  confirmedAt DateTime? @map("confirmed_at")
  lastError   String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([launchId, status, createdAt], map: "launch_fee_attempt_launch_status_created_idx")
  @@index([network, status], map: "launch_fee_attempt_network_status_idx")
  @@map("agent_launch_fee_distribution_attempts")
}

model AgentLaunchEvent {
  id String @id @default(cuid())

  launchId String      @map("launch_id")
  launch   AgentLaunch @relation(fields: [launchId], references: [id], onDelete: Cascade)

  type        String
  txSignature String? @map("tx_signature")
  payloadJson Json?   @map("payload_json")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([launchId])
  @@index([type])
  @@index([txSignature])
  @@map("agent_launch_events")
}

/// Metaplex Genesis agent-token launch attempts (app launchpad).
model MetaplexLaunchAttempt {
  id                   String    @id @default(cuid())
  publicAttributionId  String    @unique @map("public_attribution_id")
  agentDbId            Int       @map("agent_db_id")
  userProfileId        Int?      @map("user_profile_id")
  publicCreatorWallet  String?   @map("public_creator_wallet")
  walletAddress        String    @map("wallet_address")
  network              String    @default("devnet")
  status               String    @default("DRAFT")
  inputSnapshot        Json?     @map("input_snapshot")
  imageUri             String?   @map("image_uri")
  metadataUri          String?   @map("metadata_uri")
  assetAddress         String?   @unique @map("asset_address")
  identityPda          String?   @map("identity_pda")
  tokenMint            String?   @unique @map("token_mint")
  genesisAddress       String?   @unique @map("genesis_address")
  metaplexLaunchUrl    String?   @map("metaplex_launch_url")
  agentTxSignature     String?   @map("agent_tx_signature")
