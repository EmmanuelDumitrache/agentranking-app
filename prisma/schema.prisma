// Unified order model for all payment products
/// Daily order-number LIKE allocation uses a migration-managed pg_trgm GIN index.
model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique
  productType         String // "power_boost" | "ad" | "kya_verify"
  tier                String // "Mini"|"Standard"|"Pro"|"Golden"|"Starter"|"Growth"|"Launch"
  usdPrice            Float
  paymentAsset        String      @default("USDC") // "USDC" | "ETH"
  chainId             Int         @default(8453) // Base
  cryptoAmount        String // "49.00" USDC or "0.0123" ETH
  wallet              String
  email               String      @default("")
  txHash              String?     @unique
  status              String      @default("pending") // pending|paid|expired|cancelled
  agentId             Int?
  agent               Agent?      @relation("AgentOrders", fields: [agentId], references: [id])
  // Ad creative (for productType "ad"); KYA uses imageUrl + bannerUrl
  imageUrl            String      @default("")
  bannerUrl           String      @default("")
  linkUrl             String      @default("")
  adText              String      @default("")
  stripAdvertiserName String      @default("")
  adIconKey           String      @default("shield")
  adAccentColor       String      @default("#22c55e")
  tokenAddress        String      @default("") // KYA: verified token CA from DexScreener
  // KYA optional fields (description, social links, custom tags in kyaMetadata JSON, services in kyaServices JSON)
  kyaDescription      String      @default("")
  kyaMetadata         String      @default("{}")
  kyaServices         String      @default("[]")
  referralCode        String      @default("")
  createdAt           DateTime    @default(now())
  paidAt              DateTime?
  expiresAt           DateTime
  agentBoost          AgentBoost?
  adPackage           AdPackage?
  postActivation      OrderPostActivation?

  // wallet and status_expiresAt indexes dropped: unused per pg_stat_user_indexes (0 scans)
  @@index([agentId])
  @@index([referralCode])
}

