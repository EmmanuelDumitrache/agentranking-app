// =============================================================================
// Account-level KYC verification (Persona adapter, no PII stored)
// =============================================================================

enum AccountVerificationLevel {
  NONE
  INDIVIDUAL
  BUSINESS
}

enum AccountVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  NEEDS_REVIEW
  DECLINED
  EXPIRED
  REVOKED
}

model AccountVerification {
  id                String                    @id @default(cuid())
  appAccountId      String                    @map("app_account_id")
  appAccount        AppAccount                @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  provider          String
  providerReference String                    @map("provider_reference")
  providerSessionId String?                   @map("provider_session_id")
  level             AccountVerificationLevel  @default(INDIVIDUAL)
  status            AccountVerificationStatus
  verifiedAt        DateTime?                 @map("verified_at")
  expiresAt         DateTime?                 @map("expires_at")
  revokedAt         DateTime?                 @map("revoked_at")
  webhookEventId    String?                   @unique @map("webhook_event_id")
  attestationUid    String?                   @map("attestation_uid")
  attestationChainId String?                  @map("attestation_chain_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@index([appAccountId, createdAt])
  @@index([providerReference])
  @@index([status])
  @@map("account_verifications")
}

// =============================================================================
// AgentRanking Verification Layer (KYA) — Know Your Agent
// No PII fields. Partner names never appear in schema.
// =============================================================================

enum PassportStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum RiskTier {
  UNRATED
  BASIC
  STANDARD
  ELEVATED
  PRIVILEGED
}

model AgentPassport {
  id               String         @id @default(cuid())
  ownerWallet      String
  ownerWalletChain String
  agentId          Int
  agent            Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status           PassportStatus @default(PENDING)
  riskTier         RiskTier       @default(UNRATED)
  riskScore        Int            @default(0)
  issuedAt         DateTime?
  expiresAt        DateTime?
  revokedAt        DateTime?
  revocationReason String?
  lastScreenedAt   DateTime?
  passportHash     String         @unique
  anchorTx         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  ownershipProofs OwnershipProof[]
  delegations     AgentDelegation[] @relation("ParentPassport")
  assessments     RiskAssessment[]
  events          VerificationEvent[]

  @@index([ownerWallet])
  @@index([agentId])
  @@index([status])
  @@index([riskTier])
  @@index([status, lastScreenedAt])
}

model OwnershipChallenge {
  id            String    @id @default(cuid())
  agentId       Int
  walletAddress String
  chain         String
  purpose       String    @default("ownership")
  nonce         String    @unique
  message       String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([walletAddress])
  @@index([expiresAt])
}

model OwnershipProof {
  id            String   @id @default(cuid())
  passportId    String
  passport      AgentPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  walletAddress String
  chain         String
  message       String
  signature     String
  nonce         String   @unique
  verifiedAt    DateTime
  expiresAt     DateTime

  @@index([passportId])
  @@index([walletAddress])
}

model AgentDelegation {
  id               String    @id @default(cuid())
  parentPassportId String
  parentPassport   AgentPassport @relation("ParentPassport", fields: [parentPassportId], references: [id], onDelete: Cascade)
  delegatedAgentId Int
  delegatedAgent   Agent     @relation("DelegatedAgent", fields: [delegatedAgentId], references: [id], onDelete: Cascade)
  delegatedWallet  String
  signature        String
  scopes           String[]
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  @@index([parentPassportId])
  @@index([delegatedAgentId])
  @@index([delegatedWallet])
  @@index([active])
}

model RiskAssessment {
  id              String   @id @default(cuid())
  passportId      String
  passport        AgentPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  score           Int
  tier            RiskTier
  factors         Json
  assessedAt      DateTime @default(now())
  assessorVersion String

  @@index([passportId, assessedAt])
}

model VerificationEvent {
  id         String   @id @default(cuid())
  passportId String
  passport   AgentPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  eventType  String
  detail     Json
  createdAt  DateTime @default(now())

  @@index([passportId, createdAt])
  @@index([eventType])
}

// =============================================================================
// Agent Payments — USDC treasury + account-level payment card
// Provider-agnostic. Never store PAN/CVV. Anchor: AppAccount (user financial id).
// =============================================================================

enum TreasuryWalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum PaymentCardStatus {
  PENDING
  ACTIVE
  FROZEN
  CANCELLED
}

enum AgentIssuingCardStatus {
  PENDING
  ACTIVE
  FROZEN
  CANCELLED
}

enum TreasuryTxType {
  FUNDING
  WITHDRAWAL
  RESERVE
  RELEASE
  SPEND
  REFUND
  CARD_ISSUE
  CARD_CANCEL
  POLICY_UPDATE
  ADJUSTMENT
}

enum TreasuryTxStatus {
  PENDING
  RESERVED
  SETTLED
  FAILED
  REVERSED
}

enum FundingIntentStatus {
  CREATED
  PENDING
  CONFIRMED
  EXPIRED
  FAILED
}

/// Account-level USDC treasury. One per AppAccount (product "user").
model TreasuryWallet {
  id               String               @id @default(cuid())
  appAccountId     String               @unique @map("app_account_id")
  appAccount       AppAccount           @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  /// Available USDC in minor units (cents). 100 = $1.00
  balanceUsdcCents Int                  @default(0) @map("balance_usdc_cents")
  /// Reserved/held USDC not available to spend
  reservedUsdcCents Int                 @default(0) @map("reserved_usdc_cents")
  providerWalletId String?              @map("provider_wallet_id")
  status           TreasuryWalletStatus @default(ACTIVE)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  transactions TreasuryTransaction[]
  fundingIntents TreasuryFundingIntent[]

  @@index([status])
  @@map("treasury_wallets")
}

/// One payment card per AppAccount. Tokenized references only — never PAN/CVV.
model PaymentCard {
  id              String            @id @default(cuid())
  appAccountId    String            @unique @map("app_account_id")
  appAccount      AppAccount        @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  providerCardId  String            @map("provider_card_id")
  providerName    String            @map("provider_name")
  lastFour        String            @map("last_four")
  brand           String            @default("virtual")
  expiryMonth     Int?              @map("expiry_month")
  expiryYear      Int?              @map("expiry_year")
  status          PaymentCardStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  transactions TreasuryTransaction[]

  @@index([status])
  @@index([providerCardId])
  @@map("payment_cards")
}

/// Per-agent Stripe Issuing card (fiat balance). One virtual card per agent.
model AgentIssuingCard {
  id                 String                 @id @default(cuid())
  agentId            Int                    @unique @map("agent_id")
  agent              Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  appAccountId       String                 @map("app_account_id")
  appAccount         AppAccount             @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  stripeCardholderId String                 @unique @map("stripe_cardholder_id")
  stripeCardId       String                 @unique @map("stripe_card_id")
  providerName       String                 @default("stripe-issuing-standard") @map("provider_name")
  lastFour           String                 @map("last_four")
  brand              String                 @default("visa")
  status             AgentIssuingCardStatus @default(ACTIVE)
  riskTier           String                 @map("risk_tier")
  dailyLimitCents    Int                    @map("daily_limit_cents")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  authorizations AgentIssuingAuthorization[]

  @@index([appAccountId])
  @@index([status])
  @@map("agent_issuing_cards")
}

/// Authorization decisions for agent Stripe Issuing cards (daily spend rollup).
model AgentIssuingAuthorization {
  id                    String           @id @default(cuid())
  agentIssuingCardId    String           @map("agent_issuing_card_id")
  agentIssuingCard      AgentIssuingCard @relation(fields: [agentIssuingCardId], references: [id], onDelete: Cascade)
  stripeAuthorizationId String           @unique @map("stripe_authorization_id")
  amountCents           Int              @map("amount_cents")
  currency              String           @default("usd")
  approved              Boolean
  declineReason         String?          @map("decline_reason")
  merchantName          String?          @map("merchant_name")
  eventType             String           @map("event_type")
  createdAt             DateTime         @default(now()) @map("created_at")

  @@index([agentIssuingCardId, createdAt])
  @@map("agent_issuing_authorizations")
}

enum AgentStablecoinLedgerEntryType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

/// Per-agent stablecoin balance for Lithic JIT card spend (we own the ledger; Lithic only processes auth).
model AgentStablecoinLedger {
  id                String   @id @default(cuid())
  agentId           Int      @unique @map("agent_id")
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  balanceUsdcCents  Int      @default(0) @map("balance_usdc_cents")
  reservedUsdcCents Int      @default(0) @map("reserved_usdc_cents")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  entries AgentStablecoinLedgerEntry[]

  @@map("agent_stablecoin_ledgers")
}

model AgentStablecoinLedgerEntry {
  id                String                         @id @default(cuid())
  ledgerId          String                         @map("ledger_id")
  ledger            AgentStablecoinLedger          @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  type              AgentStablecoinLedgerEntryType
  amountCents       Int                            @map("amount_cents")
  balanceAfterCents Int                            @map("balance_after_cents")
  referenceType     String?                        @map("reference_type")
  referenceId       String?                        @map("reference_id")
  note              String?
  createdAt         DateTime                       @default(now()) @map("created_at")

  @@index([ledgerId, createdAt])
  @@unique([referenceType, referenceId], map: "agent_stablecoin_ledger_entries_reference_type_reference_id_key")
  @@map("agent_stablecoin_ledger_entries")
}

/// Per-agent Lithic virtual card (stablecoin-funded via internal ledger + ASA).
model AgentLithicCard {
  id              String                 @id @default(cuid())
  agentId         Int                    @unique @map("agent_id")
  agent           Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  appAccountId    String                 @map("app_account_id")
  appAccount      AppAccount             @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  lithicCardToken String                 @unique @map("lithic_card_token")
  providerName    String                 @default("lithic") @map("provider_name")
  lastFour        String                 @map("last_four")
  brand           String                 @default("mastercard")
  status          AgentIssuingCardStatus @default(ACTIVE)
  riskTier        String                 @map("risk_tier")
  dailyLimitCents Int                    @map("daily_limit_cents")
  memo            String?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  authorizations AgentLithicAuthorization[]

  @@index([appAccountId])
  @@index([status])
  @@map("agent_lithic_cards")
}

/// Lithic ASA authorization decisions (daily spend rollup + audit).
model AgentLithicAuthorization {
  id                       String          @id @default(cuid())
  agentLithicCardId        String          @map("agent_lithic_card_id")
  agentLithicCard          AgentLithicCard @relation(fields: [agentLithicCardId], references: [id], onDelete: Cascade)
  lithicAuthorizationToken String          @unique @map("lithic_authorization_token")
  amountCents              Int             @map("amount_cents")
  currency                 String          @default("usd")
  approved                 Boolean
  asaResult                String          @map("asa_result")
  declineReason            String?         @map("decline_reason")
  merchantName             String?         @map("merchant_name")
  merchantCategoryCode     String?         @map("merchant_category_code")
  balanceAfterCents        Int?            @map("balance_after_cents")
  createdAt                DateTime        @default(now()) @map("created_at")

  @@index([agentLithicCardId, createdAt])
  @@map("agent_lithic_authorizations")
}

/// Per-agent Marqeta user + virtual card (stablecoin-funded via internal ledger + JIT gateway).
model AgentMarqetaCard {
  id               String                 @id @default(cuid())
  agentId          Int                    @unique @map("agent_id")
  agent            Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  appAccountId     String                 @map("app_account_id")
  appAccount       AppAccount             @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  marqetaUserToken String                 @unique @map("marqeta_user_token")
  marqetaCardToken String                 @unique @map("marqeta_card_token")
  cardProductToken String                 @map("card_product_token")
  providerName     String                 @default("marqeta") @map("provider_name")
  lastFour         String                 @map("last_four")
  brand            String                 @default("visa")
  status           AgentIssuingCardStatus @default(ACTIVE)
  riskTier         String                 @map("risk_tier")
  dailyLimitCents  Int                    @map("daily_limit_cents")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  authorizations AgentMarqetaAuthorization[]

  @@index([appAccountId])
  @@index([status])
  @@map("agent_marqeta_cards")
}

/// Marqeta Gateway JIT funding decisions (daily spend rollup + audit).
model AgentMarqetaAuthorization {
  id                       String           @id @default(cuid())
  agentMarqetaCardId       String           @map("agent_marqeta_card_id")
  agentMarqetaCard         AgentMarqetaCard @relation(fields: [agentMarqetaCardId], references: [id], onDelete: Cascade)
  marqetaJitFundingToken   String           @unique @map("marqeta_jit_funding_token")
  marqetaTransactionToken  String?          @map("marqeta_transaction_token")
  jitMethod                String           @map("jit_method")
  amountCents              Int              @map("amount_cents")
  currency                 String           @default("usd")
  approved                 Boolean
  declineReason            String?          @map("decline_reason")
  merchantName             String?          @map("merchant_name")
  merchantCategoryCode     String?          @map("merchant_category_code")
  balanceAfterCents        Int?             @map("balance_after_cents")
  createdAt                DateTime         @default(now()) @map("created_at")

  @@index([agentMarqetaCardId, createdAt])
  @@map("agent_marqeta_authorizations")
}

/// Per-agent AR virtual card (Kripicard prepaid balance).
model AgentKripicardCard {
  id               String                 @id @default(cuid())
  /// Optional attribution — all agents on the account share this card.
  agentId          Int?                   @map("agent_id")
  agent            Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  appAccountId     String                 @map("app_account_id")
  appAccount       AppAccount             @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  kripicardCardId  String                 @unique @map("kripicard_card_id")
  bin              String
  providerName     String                 @default("ar") @map("provider_name")
  lastFour         String                 @map("last_four")
  brand            String                 @default("mastercard")
  nameOnCard       String                 @map("name_on_card")
  status           AgentIssuingCardStatus @default(ACTIVE)
  riskTier         String                 @map("risk_tier")
  initialAmountUsd Float                  @map("initial_amount_usd")
  freezePinHash    String?                @map("freeze_pin_hash")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  @@index([status])
  @@index([agentId])
  @@index([appAccountId])
  @@map("agent_kripicard_cards")
}

/// Account-scoped merchant substring search uses a migration-managed btree_gin/pg_trgm GIN index.
model TreasuryTransaction {
  id                    String           @id @default(cuid())
  appAccountId          String           @map("app_account_id")
  appAccount            AppAccount       @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  agentId               Int?             @map("agent_id")
  agent                 Agent?           @relation("AgentTreasuryTransactions", fields: [agentId], references: [id], onDelete: SetNull)
  walletId              String           @map("wallet_id")
  wallet                TreasuryWallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  cardId                String?          @map("card_id")
  card                  PaymentCard?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  type                  TreasuryTxType
  amountCents           Int              @map("amount_cents")
  currency              String           @default("USDC")
  merchant              String?
  category              String?
  reason                String?
  status                TreasuryTxStatus @default(PENDING)
  providerTransactionId String?          @map("provider_transaction_id")
  idempotencyKey        String?          @unique @map("idempotency_key")
  balanceAfterCents     Int?             @map("balance_after_cents")
  metadata              Json?
  createdAt             DateTime         @default(now()) @map("created_at")

  @@index([appAccountId, createdAt])
  @@index([agentId, createdAt])
  @@index([walletId, createdAt])
  @@index([status])
  @@index([type])
  @@index([merchant])
  @@index([category])
  @@map("treasury_transactions")
}

model SpendingPolicy {
  id                 String   @id @default(cuid())
  appAccountId       String   @unique @map("app_account_id")
  appAccount         AppAccount @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  dailyLimitCents    Int      @default(10000) @map("daily_limit_cents")
  weeklyLimitCents   Int      @default(50000) @map("weekly_limit_cents")
  monthlyLimitCents  Int      @default(200000) @map("monthly_limit_cents")
  allowedCategories  String[] @default([]) @map("allowed_categories")
  blockedCategories  String[] @default([]) @map("blocked_categories")
  allowManualUsage   Boolean  @default(true) @map("allow_manual_usage")
  allowAgentUsage    Boolean  @default(true) @map("allow_agent_usage")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("spending_policies")
}

model TreasuryFundingIntent {
  id               String              @id @default(cuid())
  appAccountId     String              @map("app_account_id")
  appAccount       AppAccount          @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  walletId         String              @map("wallet_id")
  wallet           TreasuryWallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amountCents      Int                 @map("amount_cents")
  currency         String              @default("USDC")
  status           FundingIntentStatus @default(CREATED)
  providerIntentId String?             @map("provider_intent_id")
  providerName     String              @map("provider_name")
  checkoutUrl      String?             @map("checkout_url")
  idempotencyKey   String?             @unique @map("idempotency_key")
  confirmedAt      DateTime?           @map("confirmed_at")
  expiresAt        DateTime?           @map("expires_at")
  metadata         Json?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([appAccountId, createdAt])
  @@index([status])
  @@map("treasury_funding_intents")
}

model TreasuryAuditLog {
  id         String   @id @default(cuid())
  appAccountId String @map("app_account_id")
  appAccount AppAccount @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([appAccountId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("treasury_audit_logs")
}
