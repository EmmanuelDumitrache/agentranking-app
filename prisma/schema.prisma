/// Login-first creator account (one per UserProfile). Holds custodial account wallet + credit balances.
/// Creator admin substring search uses a migration-managed pg_trgm GIN index.
model AppAccount {
  id            String      @id @default(cuid())
  userProfileId Int         @unique @map("user_profile_id")
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  displayName String? @map("display_name")
  email       String?
  imageUrl    String? @map("image_url")

  accountWalletId String?          @unique @map("account_wallet_id")
  accountWallet   CustodialWallet? @relation("AppAccountWallet", fields: [accountWalletId], references: [id], onDelete: SetNull)

  maxAgents                Int       @default(3) @map("max_agents")
  platformCredits          Int       @default(0) @map("platform_credits")
  llmBalanceCents          Int       @default(0) @map("llm_balance_cents")
  cachedSolBalanceLamports BigInt?   @map("cached_sol_balance_lamports")
  lastBalanceSyncAt        DateTime? @map("last_balance_sync_at")
  onboardingCompletedAt    DateTime? @map("onboarding_completed_at")

  agents               Agent[]                 @relation("AgentOwnerAccount")
  creditLedger         AccountCreditLedger[]
  llmCreditDeposits    LlmCreditDeposit[]
  llmChatConversations AgentChatConversation[]
  agentSchedules       AgentSchedule[]
  llmProviderCredentials LlmProviderCredential[]
  mcpConnections         AgentMcpConnection[]
  mcpBindings            AgentMcpBinding[]
  mcpCredentials         AgentMcpCredential[]
  mcpOAuthTransactions   AgentMcpOAuthTransaction[]
  mcpContinuations      AgentMcpContinuation[]
  mcpAuditLogs           AgentMcpAuditLog[]
  agentMemorySettings  AgentMemorySettings[]
  agentMemoryFacts     AgentMemoryFact[]
  treasuryWallet       TreasuryWallet?
  paymentCard          PaymentCard?
  spendingPolicy       SpendingPolicy?
  agentIssuingCards    AgentIssuingCard[]
  agentLithicCards     AgentLithicCard[]
  agentMarqetaCards    AgentMarqetaCard[]
  agentKripicardCards    AgentKripicardCard[]
  treasuryTransactions TreasuryTransaction[]
  treasuryFundingIntents TreasuryFundingIntent[]
  treasuryAuditLogs    TreasuryAuditLog[]
  accountVerifications AccountVerification[]

  publicId                 String                    @unique @map("public_id")
  verificationLevel        AccountVerificationLevel  @default(NONE) @map("verification_level")
  verificationStatus       AccountVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt               DateTime?                 @map("verified_at")
  verificationExpiresAt    DateTime?                 @map("verification_expires_at")
  verificationRevokedAt    DateTime?                 @map("verification_revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_accounts")
}

/// Server-side keypair storage (Solana or EVM). Private keys are AES-256-GCM encrypted; never exposed to clients.
/// Admin public-key substring lookup uses a migration-managed pg_trgm GIN index.
model CustodialWallet {
  id                String               @id @default(cuid())
  scope             CustodialWalletScope
  /// "solana" | "evm"
  chain             String               @default("solana")
  publicKey         String               @unique @map("public_key")
  encryptedSecret   String               @map("encrypted_secret") @db.Text
  encryptionKeyId   String               @default("env:v1") @map("encryption_key_id")
  encryptionVersion Int                  @default(1) @map("encryption_version")

  appAccount        AppAccount?          @relation("AppAccountWallet")
  agent             Agent?               @relation("AgentCustodialWallet")
  agentEvm          Agent?               @relation("AgentEvmCustodialWallet")
  auditEvents       CustodialWalletAudit[]
  transfers         CustodialWalletTransfer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([scope])
  @@index([chain])
  @@map("custodial_wallets")
}

model AccountCreditLedger {
  id             String            @id @default(cuid())
  appAccountId   String            @map("app_account_id")
  appAccount     AppAccount        @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  creditType     AccountCreditType @map("credit_type")
  delta          Int
  balanceAfter   Int               @map("balance_after")
  reason         String
  referenceId    String?           @map("reference_id")
  idempotencyKey String?           @unique @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([appAccountId, creditType])
  @@index([createdAt])
  @@map("account_credit_ledger")
}

model CustodialWalletAudit {
  id             String          @id @default(cuid())
  walletId       String          @map("wallet_id")
  wallet         CustodialWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  action         String
  actorProfileId Int?            @map("actor_profile_id")
  metadataJson   Json?           @map("metadata_json")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([walletId])
  @@index([createdAt])
  @@map("custodial_wallet_audit")
}

model CustodialWalletTransfer {
  id             String          @id @default(cuid())
  walletId       String          @map("wallet_id")
  wallet         CustodialWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  agentDbId      Int?            @map("agent_db_id")
  network        String
  token          String          @default("SOL")
  fromPublicKey  String          @map("from_public_key")
  toPublicKey    String          @map("to_public_key")
  amountLamports BigInt          @map("amount_lamports")
  signature      String?
  status         String          @default("pending")
  errorMessage   String?         @map("error_message") @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  confirmedAt    DateTime?       @map("confirmed_at")

  @@index([walletId])
  @@index([agentDbId])
  @@index([createdAt])
  @@map("custodial_wallet_transfers")
}

model AgentChatConversation {
  id                     String                      @id @default(cuid())
  agentDbId              Int                         @map("agent_db_id")
  agent                  Agent                       @relation(fields: [agentDbId], references: [id], onDelete: Cascade)
  appAccountId           String                      @map("app_account_id")
  appAccount             AppAccount                  @relation(fields: [appAccountId], references: [id], onDelete: Cascade)
  createdByUserProfileId Int                         @map("created_by_user_profile_id")
  createdBy              UserProfile                 @relation(fields: [createdByUserProfileId], references: [id], onDelete: Cascade)
  title                  String
  titleSource            AgentChatTitleSource        @default(DEFAULT)
  status                 AgentChatConversationStatus @default(ACTIVE)
  defaultModelKey        String                      @default("") @map("default_model_key")
  nextMessageSequence    Int                         @default(1) @map("next_message_sequence")
  contextSummary         String?                     @map("context_summary") @db.Text
  summaryThroughSequence Int?                        @map("summary_through_sequence")
  summaryVersion         Int                         @default(1) @map("summary_version")
  summaryUpdatedAt       DateTime?                   @map("summary_updated_at") @db.Timestamptz(3)
  workingState           Json?                       @map("working_state")
  lastMessageAt          DateTime                    @default(now()) @map("last_message_at") @db.Timestamptz(3)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?                   @map("deleted_at") @db.Timestamptz(3)

  messages  AgentChatMessage[]
  runs      AgentChatRun[]
  artifacts AgentChatArtifact[]

  @@unique([id, appAccountId, agentDbId])
  @@index([agentDbId, lastMessageAt(sort: Desc)])
  @@index([appAccountId, updatedAt(sort: Desc)])
  @@map("agent_chat_conversations")
}

/// Lexical history search uses a migration-managed conversation + `searchText` pg_trgm/btree_gin GIN index.
model AgentChatMessage {
  id             String                @id
  conversationId String                @map("conversation_id")
  conversation   AgentChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sequence       Int
  role           AgentChatMessageRole
  parts          Json
  /** Bounded semantic projection of `parts` for lexical search (opaque payloads omitted). */
  searchText     String                @default("") @map("search_text") @db.Text
  hasFile        Boolean               @default(false) @map("has_file")
  hasImageFile   Boolean               @default(false) @map("has_image_file")
  fileCount      Int                   @default(0) @map("file_count")
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  triggeredRuns           AgentChatRun[]                 @relation("RunTriggerMessage")
  responseRun             AgentChatRun?                  @relation("RunResponseMessage")
  memoryExtractionOutbox  AgentMemoryExtractionOutbox?   @relation("MemoryExtractionSourceMessage")

  @@unique([conversationId, id])
  @@unique([conversationId, sequence])
  @@index([conversationId, sequence(sort: Desc)])
  @@map("agent_chat_messages")
}

model AgentChatRun {
  id                 String                    @id @default(cuid())
  requestId          String                    @unique @map("request_id")
  conversationId     String                    @map("conversation_id")
  appAccountId       String                    @map("app_account_id")
  agentDbId          Int                       @map("agent_db_id")
  conversation       AgentChatConversation     @relation(fields: [conversationId, appAccountId, agentDbId], references: [id, appAccountId, agentDbId], onDelete: Cascade)
  triggerMessageId   String?                   @map("trigger_message_id")
  triggerMessage     AgentChatMessage?         @relation("RunTriggerMessage", fields: [triggerMessageId], references: [id], onDelete: SetNull)
  responseMessageId  String?                   @unique @map("response_message_id")
  responseMessage    AgentChatMessage?         @relation("RunResponseMessage", fields: [responseMessageId], references: [id], onDelete: SetNull)
  parentRunId        String?                   @map("parent_run_id")
  parentRun          AgentChatRun?             @relation("RunContinuations", fields: [parentRunId], references: [id], onDelete: SetNull)
  continuations      AgentChatRun[]            @relation("RunContinuations")
  triggerKind        AgentChatRunTriggerKind   @default(USER_MESSAGE) @map("trigger_kind")
  settingsRevisionId String                    @map("settings_revision_id")
  settingsRevision   AgentChatSettingsRevision @relation(fields: [settingsRevisionId, agentDbId], references: [id, agentDbId], onDelete: Cascade)

  status           AgentChatRunLifecycle     @default(PREPARING)
  settlementStatus AgentChatSettlementStatus @default(PENDING) @map("settlement_status")
  finishReason     String?                   @map("finish_reason")

  requestedModelKey    String  @map("requested_model_key")
  initialModelKey      String  @map("initial_model_key")
  finalModelKey        String? @map("final_model_key")
  finalProvider        String? @map("final_provider")
  finalProviderModelId String? @map("final_provider_model_id")
  finalAdapter         String? @map("final_adapter")

  routingPolicy String                @map("routing_policy")
  routingReason  AgentChatRouteReason @map("routing_reason")
  routingJson    Json?                 @map("routing_json")

  pricingRevision          String  @map("pricing_revision")
  reservationInputTokens  Int     @map("reservation_input_tokens")
  reservationOutputTokens Int     @map("reservation_output_tokens")
  maxToolSteps            Int     @map("max_tool_steps")
  reservedCents           Int     @map("reserved_cents")
  finalChargeCents        Int?    @map("final_charge_cents")
  refundCents             Int?    @map("refund_cents")
  reservationLedgerId     String? @unique @map("reservation_ledger_id")
  settlementLedgerId      String? @unique @map("settlement_ledger_id")

  inputTokens       Int? @map("input_tokens")
  outputTokens      Int? @map("output_tokens")
  reasoningTokens   Int? @map("reasoning_tokens")
  cachedInputTokens Int? @map("cached_input_tokens")
  cacheWriteTokens  Int? @map("cache_write_tokens")
  totalTokens       Int? @map("total_tokens")

  localCostUsdMicros    BigInt?   @map("local_cost_usd_micros")
  providerCostUsdMicros BigInt?   @map("provider_cost_usd_micros")
  durationMs            Int?      @map("duration_ms")
  firstTokenAt          DateTime? @map("first_token_at") @db.Timestamptz(3)

  errorCode          String? @map("error_code")
  errorMessage       String? @map("error_message") @db.Text
  errorJson          Json?   @map("error_json")
  billingAnomalyJson Json?   @map("billing_anomaly_json")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  settledAt   DateTime? @map("settled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempts                 AgentChatRunAttempt[]
  runtime                  AgentChatRunRuntime?
  toolEvents               AgentChatToolEvent[]
  toolExecutions           AgentChatToolExecution[]
  memoryExtractionOutbox   AgentMemoryExtractionOutbox[] @relation("MemoryExtractionSourceRun")
  usage                    LlmRunUsage?
  artifacts                AgentChatArtifact[]

  @@unique([id, appAccountId, agentDbId])
  @@index([parentRunId, startedAt(sort: Desc)])
  @@index([conversationId, startedAt(sort: Desc)])
  @@index([appAccountId, startedAt(sort: Desc)])
  @@index([agentDbId, startedAt(sort: Desc)])
  @@index([status, startedAt])
  @@map("agent_chat_runs")
}

