  /// open|resolved
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@index([bountyId])
}

// --- Agent Mesh ---

model MeshSubscription {
  id                String   @id @default(cuid())
  subscriberAgentId Int
  publisherAgentId  Int
  subscriberAgent   Agent    @relation("MeshSubscriber", fields: [subscriberAgentId], references: [id])
  publisherAgent    Agent    @relation("MeshPublisher", fields: [publisherAgentId], references: [id])
  webhookEndpoint   String   @default("")
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  deliveries       MeshSignalDelivery[]

  @@unique([subscriberAgentId, publisherAgentId])
  @@index([subscriberAgentId])
  @@index([publisherAgentId, isActive, id], map: "MeshSubscription_fanout_scan_idx")
}

model MeshSignal {
  id               String   @id @default(cuid())
  publisherAgentId Int
  payload          Json
  signalType       String               @default("")
  timestamp        DateTime             @default(now())
  deliveries       MeshSignalDelivery[]

  @@index([publisherAgentId, timestamp])
}

model MeshSignalDelivery {
  id               String           @id @default(cuid())
  signalId         String           @map("signal_id")
  signal           MeshSignal       @relation(fields: [signalId], references: [id], onDelete: Cascade)
  subscriptionId   String           @map("subscription_id")
  subscription     MeshSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  status           String           @default("pending") // pending|delivering|delivered|failed|skipped
  attempts         Int              @default(0)
  lastError        String?          @map("last_error") @db.Text
  lastHttpStatus   Int?             @map("last_http_status")
  deliveredAt      DateTime?        @map("delivered_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([signalId, subscriptionId])
  @@index([status, createdAt])
  @@map("mesh_signal_deliveries")
}

model NotificationDelivery {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique @map("idempotency_key")
  channel        String    @default("email")
  kind           String
  recipient      String
  payload        Json
  status         String    @default("pending") // pending|delivering|delivered|failed|terminal_failed|skipped
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.Text
  lastHttpStatus Int?      @map("last_http_status")
  responsePreview String?  @map("response_preview") @db.Text
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@map("notification_deliveries")
}

model WebhookReceipt {
  id               String    @id @default(cuid())
  provider         String
  providerEventId  String    @map("provider_event_id")
  payloadHash      String    @map("payload_hash")
  status           String    @default("processing") // processing|processed|failed
  attempts         Int       @default(1)
  lastError        String?   @map("last_error") @db.Text
  processingAt     DateTime  @default(now()) @map("processing_at")
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([provider, providerEventId])
  @@index([status, processingAt])
  @@map("webhook_receipts")
}

