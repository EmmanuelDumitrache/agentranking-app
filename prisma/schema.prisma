  @@map("account_security_audits")
}

/// Webhook rules evaluated and delivered by the pg-boss Agent Alerts pipeline.
model AgentAlertRule {
  id            Int         @id @default(autoincrement())
  userProfileId Int
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  /// When null, the rule applies to all agents currently owned by this profile.
  agentId       Int?
  agent         Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  webhookUrl    String
  /// Optional shared secret: test deliveries send HMAC-SHA256 hex in X-AgentRanking-Signature (message = `${ts}.${body}`).
  secret        String?
  /// Native `text[]` of event type identifiers. `agent.event` is the generic agent-event wildcard.
  eventTypes    String[]  @default([])
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deliveries    AgentAlertDelivery[]

  @@index([userProfileId])
  @@index([agentId])
  @@index([eventTypes])
}

