/// Admin/social profile substring search uses a migration-managed pg_trgm/btree_gin GIN index.
model UserProfile {
  id             Int      @id @default(autoincrement())
  walletAddress  String?  @unique
  email          String?  @unique
  username       String?  @unique
  displayName    String?
  bio            String   @default("")
  avatarUrl      String   @default("")
  twitterUrl     String   @default("")
  githubUrl      String   @default("")
  websiteUrl     String   @default("")
  followersCount Int      @default(0)
  followingCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Dashboard subscription
  subscriptionStatus    String    @default("none") // none|pending|active|expired|cancelled
  subscriptionPlan      String    @default("") // "starter" | "pro"
  subscriptionExpiresAt DateTime?
  subscriptionStartedAt DateTime?
  helioSubscriptionId   String?

  // One-time claim link (sent after kya_verify payment)
  claimToken          String?   @unique
  claimTokenExpiresAt DateTime?
  isClaimed           Boolean   @default(false)
  claimedAt           DateTime?

  // Dashboard login credentials
  passwordHash    String?
  adminNotes      String    @default("")
  /**
   * Linked Solana operator wallet (e.g. after SAP profile claim).
   */
  solanaWallet    String?   @unique @map("solana_wallet")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  /// Authenticator (TOTP) MFA — secret is AES-GCM encrypted; never returned after enroll.
  totpEnabledAt        DateTime? @map("totp_enabled_at")
  totpSecretEnc        String?   @map("totp_secret_enc") @db.Text
  /// Last successfully consumed RFC 6238 time-step; prevents TOTP replay.
  totpLastUsedStep     BigInt?   @map("totp_last_used_step")
  /// bcrypt hashes of one-time backup codes (plaintext shown once at enroll).
  totpBackupCodesHash  String[]  @default([]) @map("totp_backup_codes_hash")
  /// When set, email OTP via Resend is an accepted MFA factor after primary sign-in.
  emailOtpMfaEnabledAt DateTime? @map("email_otp_mfa_enabled_at")
  /// Incremented whenever MFA configuration changes, revoking remembered-browser cookies.
  mfaTrustVersion      Int       @default(0) @map("mfa_trust_version")

  contactInquiries      ContactInquiry[]
  agentAlertRules       AgentAlertRule[]
  sapAgentClaims        SapAgentOperatorClaim[]
  arReferralCodes       ArReferralCode[]
  arReferralEvents      ArReferralEvent[]           @relation("ArReferralReferredProfile")
  verificationRequests  AgentVerificationRequest[]
  appAccount            AppAccount?
  chatConversations     AgentChatConversation[]
  chatSettingsRevisions AgentChatSettingsRevision[]
  securityAudits        AccountSecurityAudit[]

  @@index([walletAddress])
  @@index([claimToken])
  @@index([subscriptionStatus, subscriptionExpiresAt, id], map: "UserProfile_subscription_expiry_scan_idx")
}

