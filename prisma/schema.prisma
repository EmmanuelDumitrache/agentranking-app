  protocolVersion    String?                  @map("protocol_version") @db.VarChar(32)
  catalogRevision    Int                      @default(0) @map("catalog_revision")
  catalogHash        String?                  @map("catalog_hash") @db.VarChar(64)
  manifestVersion    Int?                     @map("manifest_version")
  version            Int                      @default(1)
  lastVerifiedAt     DateTime?                @map("last_verified_at") @db.Timestamptz(3)
  lastDiscoveredAt   DateTime?                @map("last_discovered_at") @db.Timestamptz(3)
  lastHealthyAt      DateTime?                @map("last_healthy_at") @db.Timestamptz(3)
  lastConnectedAt    DateTime?                @map("last_connected_at") @db.Timestamptz(3)
  lastErrorAt        DateTime?                @map("last_error_at") @db.Timestamptz(3)
  lastErrorCode      String?                  @map("last_error_code") @db.VarChar(64)
  lastErrorText      String?                  @map("last_error_text") @db.Text
  consecutiveFailures Int                     @default(0) @map("consecutive_failures")
  circuitOpenedAt    DateTime?                @map("circuit_opened_at") @db.Timestamptz(3)
  circuitOpenUntil   DateTime?                @map("circuit_open_until") @db.Timestamptz(3)
