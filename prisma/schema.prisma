enum IndexerBootstrapPhase {
  IDENTITY
  METADATA
  TRUST
  DERIVED
  STEADY
}

enum IndexerBootstrapStatus {
  RUNNING
  COMPLETE
  DEGRADED
  FAILED
}

enum IndexerBootstrapWorkStatus {
  PENDING
  RUNNING
  COMPLETE
  TERMINAL_DEFERRED
  DEGRADED
  FAILED
}

/// Durable dependency barrier for one indexer bootstrap or reconciliation epoch.
model IndexerBootstrapEpoch {
  id                 String                 @id @default(cuid())
  semanticGeneration String                 @map("semantic_generation")
  topologyHash       String                 @map("topology_hash")
  phase              IndexerBootstrapPhase
  status             IndexerBootstrapStatus @default(RUNNING)
  strict             Boolean                @default(false)
  startedAt          DateTime               @default(now()) @map("started_at") @db.Timestamptz(3)
  phaseStartedAt     DateTime               @default(now()) @map("phase_started_at") @db.Timestamptz(3)
  completedAt        DateTime?              @map("completed_at") @db.Timestamptz(3)
  firstAgentMaterializedAt DateTime?         @map("first_agent_materialized_at") @db.Timestamptz(3)
  firstAgentDbId     Int?                   @map("first_agent_db_id")
  publicationGeneration String?             @map("publication_generation")
  publishedAt        DateTime?              @map("published_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  sources            IndexerBootstrapSource[]
  workItems          IndexerBootstrapWorkItem[]

  @@index([status, phase])
  @@index([topologyHash, status])
  @@map("indexer_bootstrap_epochs")
}

/// Per-source terminal state used by the bootstrap coordinator. Source cursors remain authoritative.
model IndexerBootstrapSource {
  id                 String                     @id @default(cuid())
  epochId            String                     @map("epoch_id")
  epoch              IndexerBootstrapEpoch      @relation(fields: [epochId], references: [id], onDelete: Cascade)
  sourceKey          String                     @map("source_key")
  phase              IndexerBootstrapPhase
  domain             String
  required           Boolean                    @default(true)
  status             IndexerBootstrapWorkStatus @default(PENDING)
  targetBlock        BigInt?                    @map("target_block")
  targetSlot         BigInt?                    @map("target_slot")
  targetGeneration   BigInt?                    @map("target_generation")
  observedBlock      BigInt?                    @map("observed_block")
  observedSlot       BigInt?                    @map("observed_slot")
  observedGeneration BigInt?                    @map("observed_generation")
  discoveredCount    Int                        @default(0) @map("discovered_count")
  completedCount     Int                        @default(0) @map("completed_count")
  rejectedCount      Int                        @default(0) @map("rejected_count")
  degradedReason     String?                    @map("degraded_reason")
  lastError          String?                    @map("last_error") @db.Text
  startedAt          DateTime?                  @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?                  @map("completed_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([epochId, sourceKey, phase])
  @@index([epochId, phase, status])
  @@map("indexer_bootstrap_sources")
}

/// Fine-grained terminal state for materialization, metadata, trust, and derived work.
model IndexerBootstrapWorkItem {
  epochId        String                     @map("epoch_id")
  epoch          IndexerBootstrapEpoch      @relation(fields: [epochId], references: [id], onDelete: Cascade)
  workKey        String                     @map("work_key")
  phase          IndexerBootstrapPhase
  sourceKey      String?                    @map("source_key")
  agentDbId      Int?                       @map("agent_db_id")
  status         IndexerBootstrapWorkStatus @default(PENDING)
  attempts       Int                        @default(0)
  terminalReason String?                    @map("terminal_reason")
  lastError      String?                    @map("last_error") @db.Text
  startedAt      DateTime?                  @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?                  @map("completed_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([epochId, workKey])
  @@index([epochId, phase, status])
  @@index([agentDbId, phase, status])
  @@map("indexer_bootstrap_work_items")
}

/// Non-overlapping EVM range allocation. Contiguous source cursors advance only across completed leases.
/// A migration-managed btree_gist exclusion constraint rejects overlapping non-invalidated ranges per source.
model IndexerRangeLease {
  id                   String    @id @default(cuid())
  sourceKey            String    @map("source_key")
  chainId              Int       @map("chain_id")
  domain               String
  registryAddress      String?   @map("registry_address")
  registryGeneration   String?   @map("registry_generation")
  requestedGeneration  BigInt?   @map("requested_generation")
  revision             Int       @default(0)
  fromBlock            BigInt    @map("from_block")
  toBlock              BigInt    @map("to_block")
  targetBlock          BigInt    @map("target_block")
  status               String
  holder               String?
  leaseUntil           DateTime? @map("lease_until") @db.Timestamptz(3)
  finalityPolicy       String?   @map("finality_policy")
  sourceHead           BigInt?   @map("source_head")
  canonicalHead        BigInt?   @map("canonical_head")
  endBlockHash         String?   @map("end_block_hash")
  discoveredCount      Int       @default(0) @map("discovered_count")
  decodedCount         Int       @default(0) @map("decoded_count")
  rejectedCount        Int       @default(0) @map("rejected_count")
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  error                String?   @db.Text

  @@unique([sourceKey, fromBlock, toBlock])
  @@index([sourceKey, status, fromBlock])
  @@map("indexer_range_leases")
}

