{
  "name": "agentranking-app",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "check": "pnpm run verify:type-provenance && pnpm run verify:mcp-architecture && pnpm run verify:byok-multi-provider && pnpm run typecheck && pnpm run typecheck:worker && pnpm run lint",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:extensions:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-postgres-extensions.mjs",
    "demo:setup": "pnpm run db:migrate && pnpm run demo:seed",
    "demo:seed": "node --env-file-if-exists=.env.local scripts/demo/seed.mjs",
    "demo:score": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/demo/score.ts",
    "demo:export": "node --env-file-if-exists=.env.local scripts/demo/export-snapshot.mjs",
    "worker:build": "tsdown --config tsdown.config.ts",
    "start:worker": "node --env-file=.env dist/worker/main.mjs",
    "test:verification": "node --conditions=react-server --import tsx --test src/lib/verification/__tests__/*.test.ts",
    "test:payments": "tsx --test src/lib/agent-payments/__tests__/*.test.ts",
    "test:agentcard": "tsx --test src/lib/agent-trading/agentcard/__tests__/*.test.ts",
    "test:mcp": "node --conditions=react-server --import tsx --test src/features/agent-chat/server/mcp/__tests__/*.test.ts src/lib/public-mcp/__tests__/*.test.ts",
    "test:agent-chat-client": "tsx --test src/features/agent-chat/client/__tests__/*.test.ts",
    "test:bounded-http-body": "node --conditions=react-server --import tsx --test src/lib/__tests__/*.test.ts",
    "test:refined-types": "tsx --test packages/agent-domain/src/__tests__/*.test.ts",
    "test:byok": "node --conditions=react-server --import tsx --test src/lib/llm-provider/credentials/__tests__/*.test.ts",
    "verify:type-provenance": "node scripts/verify-type-provenance.mjs",
    "verify:ownership": "node scripts/verify-client-server-ownership.mjs",
    "verify:mcp-architecture": "node scripts/verify-mcp-architecture.mjs",
    "verify:byok-multi-provider": "node scripts/verify-byok-multi-provider.mjs",
    "clean": "node -e \"for (const p of ['.next', 'dist', 'tmp']) require('node:fs').rmSync(p, { recursive: true, force: true })\""
  },
